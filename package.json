{
  "name": "archi",
  "displayName": "Archi",
  "description": "Source-backed architecture diagrams for VS Code workspaces",
  "version": "0.1.1",
  "publisher": "tinomupezeni",
  "private": true,
  "license": "MIT",
  "author": "Tinotendamupezeni",
  "repository": {
    "type": "git",
    "url": "https://github.com/tinomupezeni/ArchiTino.git"
  },
  "bugs": {
    "url": "https://github.com/tinomupezeni/ArchiTino/issues"
  },
  "homepage": "https://github.com/tinomupezeni/ArchiTino#readme",
  "icon": "media/icons/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "onCommand:archi.analyzeWorkspace",
    "onCommand:archi.showFixture",
    "onCommand:archi.openLastDiagram",
    "onCommand:archi.selectComposeFile"
  ],
  "contributes": {
    "commands": [
      {
        "command": "archi.analyzeWorkspace",
        "title": "Archi: Analyze Workspace"
      },
      {
        "command": "archi.showFixture",
        "title": "Archi: Show Fixture Diagram"
      },
      {
        "command": "archi.openLastDiagram",
        "title": "Archi: Open Last Diagram"
      },
      {
        "command": "archi.selectComposeFile",
        "title": "Archi: Select Compose File"
      }
    ],
    "configuration": {
      "title": "Archi",
      "properties": {
        "archi.maxFiles": {
          "type": "integer",
          "default": 10000,
          "minimum": 1,
          "maximum": 100000,
          "description": "Maximum workspace files considered during analysis."
        },
        "archi.serviceAliases": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Map Compose service names to a shared logical service name."
        },
        "archi.serviceGroups": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Map logical service names to area labels in the architecture map."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-vendor.cjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/test/graph.test.js dist/test/compose.test.js dist/test/pythonModels.test.js dist/test/pythonRoutes.test.js dist/test/pythonTasks.test.js dist/test/viewState.test.js test/webview.test.cjs",
    "test:extension": "npm run build && node ./scripts/test-extension.cjs",
    "benchmark": "npm run build && node ./scripts/benchmark.cjs",
    "package": "npm run build && vsce package --githubBranch main"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.1.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@lezer/common": "^1.5.4",
    "@lezer/python": "^1.1.19",
    "yaml": "^2.9.1"
  }
}
